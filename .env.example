# Azure deployment values for GitHub Actions.
# Do not put real secrets in this file.
#
# Add these values in GitHub:
# Repository -> Settings -> Secrets and variables -> Actions -> New repository secret

# Azure resource access
AZURE_CREDENTIALS={"clientId":"<client-id>","clientSecret":"<client-secret>","subscriptionId":"<subscription-id>","tenantId":"<tenant-id>","activeDirectoryEndpointUrl":"https://login.microsoftonline.com","resourceManagerEndpointUrl":"https://management.azure.com/","activeDirectoryGraphResourceId":"https://graph.windows.net/","sqlManagementEndpointUrl":"https://management.core.windows.net:8443/","galleryEndpointUrl":"https://gallery.azure.com/","managementEndpointUrl":"https://management.core.windows.net/"}
AZURE_RESOURCE_GROUP=n8n-rg

# Azure Container Registry
AZURE_ACR_NAME=<your-acr-name>
AZURE_ACR_LOGIN_SERVER=<your-acr-name>.azurecr.io

# Azure Container Apps
AZURE_CONTAINER_APP_ENVIRONMENT=n8n-env
AZURE_CONTAINER_APP_NAME=n8n

# Azure PostgreSQL Flexible Server
DB_HOST=<your-postgres-server>.postgres.database.azure.com
DB_DATABASE=n8n
DB_USER=n8nadmin
DB_PASSWORD=<your-postgres-password>

# n8n runtime config
N8N_ENCRYPTION_KEY=<openssl-rand-hex-32>
N8N_AI_OPENAI_KEY=<your-openai-api-key>
N8N_HOST=<your-container-app-host-without-https>
WEBHOOK_URL=https://<your-container-app-host>
GENERIC_TIMEZONE=America/Managua

# These are set by the workflow in Azure Container Apps.
# They are listed here so you can see the final n8n runtime shape.
NODE_ENV=production
N8N_PORT=5678
N8N_PROTOCOL=https
DB_TYPE=postgresdb
DB_POSTGRESDB_PORT=5432
